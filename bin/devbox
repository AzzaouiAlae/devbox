#!/usr/bin/env bash
# devbox — dev-container helper. Same commands on a school machine, a VM, or your
# own laptop.
#
#   devbox ui [--build|--docker] [dir]     the control panel (small always-on-top app)
#   devbox init <angular|dotnet|cpp|base>  scaffold ./.devcontainer/ for a project
#          [--network <name>]               ... and join that docker network
#          [--force]                        ... replace an existing setup
#   devbox templates                       the template names, one per line
#   devbox network [<name>|--none] [dir]   show / set / remove that network later
#   devbox open [dir]                      open a folder in VSCode
#   devbox container [dir]                 open it already inside its dev container
#   devbox up [image] [--network <name>]   quick throwaway container, home mounted
#   devbox shell                           shell into that throwaway container
#   devbox down                            stop & remove it
#   devbox where                           store, docker mode, socket, versions
#   devbox gc [--hard]                     reclaim store space (full goinfre)
#   devbox store [--set <path>|--clear]    where the heavy tier lives (any disk)
#          [--repick]                       ... move onto the best place now
#   devbox ext save|restore|list|extras    your extension list (survives a switch)
#   devbox ext repair|retry                reinstall extensions that went missing
#   devbox fix-perms [dir]                 take back files a container made
#   devbox goinfre                         create /goinfre/$USER (asks for sudo once)
#   devbox check-versions [repo]           all four Node versions must agree
#   devbox doctor                          full status report
set -euo pipefail

: "${VS_SETUP_HOME:=$HOME/.config/vscode-setup}"
. "$VS_SETUP_HOME/config.sh"
. "$VS_SETUP_HOME/lib/common.sh"
. "$VS_SETUP_HOME/lib/vscode.sh"
. "$VS_SETUP_HOME/lib/docker.sh"
. "$VS_SETUP_HOME/lib/ui.sh"

TEMPLATES="$VS_SETUP_HOME/templates/devcontainer"
QUICK_NAME="devbox-$(id -un)"
QUICK_IMAGE_DEFAULT="mcr.microsoft.com/devcontainers/base:3.0.3-noble"

# --- scaffolding -------------------------------------------------------------

# _nvmrc_version [dir] : the Node version this project already pins, if any.
_nvmrc_version() {
  local d="${1:-.}" f
  for f in "$d/.nvmrc" "$d/src/Angular/.nvmrc"; do
    [ -f "$f" ] && { tr -d ' \tv\r\n' < "$f"; return 0; }
  done
  return 1
}

# --- the shared network ------------------------------------------------------
# A dev container reaches other containers by name only if it is on the same
# docker network. Which network that is belongs to the PROJECT, not to devbox:
# ft_transendence calls it topoease, the next project will call it something else.
# So it is an option, and leaving it out is fine - plenty of projects need none.

_dc_file() { # [dir] -> path of the project's devcontainer.json
  local d="${1:-.}"
  [ -f "$d/.devcontainer/devcontainer.json" ] || return 1
  echo "$d/.devcontainer/devcontainer.json"
}

# _dc_set_network <file> <names|""> : write (or clear) the two keys that do the
# joining. Edited as real JSON, never with sed, so a typo cannot corrupt the file.
#   initializeCommand : runs on the MACHINE before the container exists, and
#                       creates the network if nobody has yet.
#   postStartCommand  : runs INSIDE, every start, and joins it.
_dc_set_network() {
  local file="$1" names="$2"
  have python3 || { error "python3 is needed to edit devcontainer.json safely"; return 1; }
  python3 - "$file" "$names" <<'PY'
import json, sys
file, names = sys.argv[1], sys.argv[2]
d = json.load(open(file))
drop = ("//net", "initializeCommand", "postStartCommand")
kept = {k: v for k, v in d.items() if k not in drop}

new = {}
if names:
    lst = " ".join(n.strip() for n in names.replace(",", " ").split() if n.strip())
    # No ${...} anywhere in these strings: VSCode would try to substitute it.
    new["//net"] = ("Shared docker network(s) this dev container joins, so it can "
                    "reach the project's other containers by name. Created on the "
                    "machine if it does not exist yet.")
    new["initializeCommand"] = (
        "bash -c 'for n in %s; do docker network inspect $n >/dev/null 2>&1 "
        "|| docker network create $n; done'" % lst)
    new["postStartCommand"] = (
        "bash -c 'h=$(cat /etc/hostname); for n in %s; do "
        "docker network connect $n \"$h\" 2>/dev/null || true; done'" % lst)

out = {}
for k, v in kept.items():
    if k == "customizations" and new:          # keep it readable: net before extensions
        out.update(new); new = {}
    out[k] = v
out.update(new)

with open(file, "w") as fh:
    json.dump(out, fh, indent=2)
    fh.write("\n")
PY
}

# _dc_get_network <file> : print the network names currently wired in, if any.
_dc_get_network() {
  python3 - "$1" <<'PY' 2>/dev/null
import json, re, sys
d = json.load(open(sys.argv[1]))
m = re.search(r"for n in (.+?); do", d.get("postStartCommand", ""))
print(m.group(1) if m else "")
PY
}

# _compose_network [dir] : the fixed network name this project's compose declares,
# so we can point at it instead of making the developer go and read the file.
_compose_network() {
  local d="${1:-.}" f
  for f in "$d/docker-compose.yml" "$d/docker-compose.yaml" "$d/compose.yml"; do
    [ -f "$f" ] || continue
    have python3 || return 1
    python3 - "$f" <<'PY' 2>/dev/null
import sys, re
txt = open(sys.argv[1]).read()
m = re.search(r"^networks:\s*$(.*?)(?=^\S|\Z)", txt, re.M | re.S)
if m:
    names = re.findall(r"^\s+name:\s*([A-Za-z0-9._-]+)\s*$", m.group(1), re.M)
    if len(names) == 1:
        print(names[0])
PY
    return 0
  done
  return 1
}

# _dc_template_name <file> : which template a project was scaffolded from. The
# templates put their own name in "name", and that is the only marker we need.
_dc_template_name() {
  python3 - "$1" <<'PY' 2>/dev/null
import json, sys
print(json.load(open(sys.argv[1])).get("name", ""))
PY
}

# cmd_templates : the list, one per line. Add a folder under templates/devcontainer
# and it shows up here, in `init`'s error message, and in the control panel.
cmd_templates() {
  local d
  for d in "$TEMPLATES"/*/; do
    [ -f "$d/devcontainer.json" ] && basename "$d"
  done
}

cmd_init() {
  # One name per statement: bash expands every argument of `local` before it runs
  # any of them, so a second assignment cannot use the first one's value.
  local type="base"
  local net=""
  local force=0
  local src v hint cur file
  while [ $# -gt 0 ]; do
    case "$1" in
      --network) net="${2:-}"; shift 2 || true;;
      --network=*) net="${1#*=}"; shift;;
      --force|-f) force=1; shift;;
      -*) error "unknown option '$1' (usage: devbox init <type> [--network <name>] [--force])"; exit 1;;
      *) type="$1"; shift;;
    esac
  done
  src="$TEMPLATES/$type"
  [ -d "$src" ] || { error "unknown template '$type' (have: $(cmd_templates | tr '\n' ' '))"; exit 1; }

  # Already scaffolded? Then this is a CHANGE, and a change means replacing files
  # you may have edited - so it is deliberate, it is announced, and the old copy
  # is kept next door. Re-running with the same template changes nothing: that is
  # what makes this safe to wire to a button.
  if file="$(_dc_file .)"; then
    cur="$(_dc_template_name "$file")"
    if [ "$cur" = "$type" ] && [ "$force" -eq 0 ]; then
      ok "already set up from '$type' — nothing to change"
      [ -n "$net" ] && _dc_set_network "$file" "$net" && ok "network set: $net"
      return 0
    fi
    # Keep the network unless this command names one: switching template is not
    # a reason to forget which containers this project talks to.
    [ -n "$net" ] || net="$(_dc_get_network "$file")"
    rm -rf .devcontainer.bak
    mv .devcontainer .devcontainer.bak
    if [ -n "$cur" ] && [ "$cur" != "$type" ]; then
      info "changing setup: '$cur' -> '$type' (old files kept in .devcontainer.bak)"
    else
      info "re-scaffolding '$type' (old files kept in .devcontainer.bak)"
    fi
  fi

  mkdir -p .devcontainer
  cp "$src"/* .devcontainer/

  # If the project already pins a Node version, the container must use that one -
  # a dev container on a different Node than the build is the classic silent bug.
  if v="$(_nvmrc_version .)" && [ -n "$v" ] && [ -f .devcontainer/Dockerfile ]; then
    if grep -q '^ARG NODE_VERSION=' .devcontainer/Dockerfile; then
      sed -i "s/^ARG NODE_VERSION=.*/ARG NODE_VERSION=$v/" .devcontainer/Dockerfile
      ok "dev container pinned to the project's Node $v (from .nvmrc)"
    fi
  fi

  if [ -n "$net" ]; then
    _dc_set_network .devcontainer/devcontainer.json "$net" \
      && ok "dev container will join the network: $net"
  elif hint="$(_compose_network .)" && [ -n "$hint" ]; then
    info "this project's compose file declares the network '$hint'"
    info "to let the dev container reach those containers by name: devbox network $hint"
  fi
  ok "scaffolded .devcontainer/ from '$type'. Now: devbox open  ->  Reopen in Container."
}

# cmd_network : show, set, or remove the shared network of an existing project.
cmd_network() {
  local arg="${1:-}"
  local dir="${2:-.}"
  local file cur
  file="$(_dc_file "$dir")" || {
    error "no .devcontainer/devcontainer.json in $dir — run 'devbox init <type>' first"; exit 1; }

  case "$arg" in
    "")
      cur="$(_dc_get_network "$file")"
      if [ -n "$cur" ]; then echo "$cur"
      else
        echo "(none)"
        cur="$(_compose_network "$dir" || true)"
        [ -n "$cur" ] && info "this project's compose file declares '$cur' — set it with: devbox network $cur"
      fi
      ;;
    --none|none|"")
      _dc_set_network "$file" "" && ok "network wiring removed — rebuild the container to apply"
      ;;
    -*)
      error "usage: devbox network [<name>[,<name>] | --none] [dir]"; exit 1;;
    *)
      _dc_set_network "$file" "$arg" \
        && ok "dev container will join: $arg  (rebuild the container to apply)"
      ;;
  esac
}

# --- throwaway container -----------------------------------------------------

cmd_up() {
  local image="$QUICK_IMAGE_DEFAULT"
  local net=""
  local args=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --network) net="${2:-}"; shift 2 || true;;
      --network=*) net="${1#*=}"; shift;;
      *) image="$1"; shift;;
    esac
  done
  if [ -n "$net" ]; then
    docker network inspect "$net" >/dev/null 2>&1 || docker network create "$net" >/dev/null
    args+=(--network "$net")
  fi
  if docker ps -a --format '{{.Names}}' | grep -qx "$QUICK_NAME"; then
    docker start "$QUICK_NAME" >/dev/null
  else
    info "starting $QUICK_NAME from $image (your home mounted, docker socket passed in)${net:+, on network $net} ..."
    docker run -d --name "$QUICK_NAME" \
      -v "$HOME:$HOME" -w "$HOME" -e HOME="$HOME" \
      -v "$VS_SOCK_LINK:/var/run/docker.sock" \
      "${args[@]+"${args[@]}"}" \
      "$image" sleep infinity >/dev/null
  fi
  ok "up. Enter it with: devbox shell"
}

cmd_shell() {
  docker ps --format '{{.Names}}' | grep -qx "$QUICK_NAME" || cmd_up
  exec docker exec -it "$QUICK_NAME" bash
}

cmd_down() {
  docker rm -f "$QUICK_NAME" >/dev/null 2>&1 && ok "removed $QUICK_NAME" || info "nothing to remove"
}

# --- opening VSCode ----------------------------------------------------------

_code() { local c="$VS_BIN_DIR/code"; [ -x "$c" ] || c="$(vscode_bin)"; echo "$c"; }

cmd_open() {
  local c; c="$(_code)"
  [ -x "$c" ] || { error "VSCode not installed yet — run: setup-doctor fix"; exit 1; }
  "$c" "${1:-.}"
}

cmd_container() {
  local c; c="$(_code)"
  [ -x "$c" ] || { error "VSCode not installed yet — run: setup-doctor fix"; exit 1; }
  local dir; dir="$(cd "${1:-.}" && pwd)"
  [ -f "$dir/.devcontainer/devcontainer.json" ] || {
    error "no .devcontainer/devcontainer.json in $dir — run: devbox init <type> first"; exit 1; }
  local hex; hex="$(printf '%s' "$dir" | od -An -tx1 | tr -d ' \n')"
  info "attaching directly to the dev container for $dir ..."
  # The templates mount the project at its real path, so it is the same inside.
  "$c" --folder-uri "vscode-remote://dev-container+$hex$dir"
}

# --- status ------------------------------------------------------------------

cmd_where() {
  echo "store            : $(cat "$VS_STORE_RECORD" 2>/dev/null || echo '?')"
  echo "docker mode      : $(cat "$VS_STATE_DIR/docker-mode" 2>/dev/null || echo '?')"
  echo "docker data-root : $(docker info -f '{{.DockerRootDir}}' 2>/dev/null || echo '?')"
  echo "docker socket    : $VS_SOCK_LINK -> $(readlink -f "$VS_SOCK_LINK" 2>/dev/null || echo 'missing')"
  echo "DOCKER_HOST      : ${DOCKER_HOST:-<unset (machine socket)>}"
  echo "pinned client    : docker $VS_DOCKER_CLI_VERSION, compose $VS_COMPOSE_VERSION, buildx $VS_BUILDX_VERSION"
  echo "vscode           : $(vscode_bin)"
}

# --- extensions --------------------------------------------------------------

cmd_ext() {
  case "${1:-list}" in
    save)    save_extension_manifest "${2:---force}";;
    restore) restore_extension_manifest;;
    list)    [ -s "$VS_EXT_MANIFEST" ] && cat "$VS_EXT_MANIFEST" || echo "(no list saved yet)";;
    # extras : install what $VS_EXTRA_EXTENSIONS says is missing, ignoring the
    # "already done once" marker. Run it after editing that list in config.sh.
    extras)  for e in $VS_EXTRA_EXTENSIONS; do echo "  $e"; done
             ensure_extra_extensions --force;;
    # repair : rebuild the saved list from what you have + what config.sh says
    # you want, then install everything on it that is missing. The button for
    # "extensions disappeared and I do not care which step lost them".
    repair)  repair_extensions;;
    # retry : only the ones whose last install actually errored.
    retry)   if [ -s "$(_vs_pending)" ]; then
               info "retrying: $(tr '\n' ' ' < "$(_vs_pending)")"
               # shellcheck disable=SC2046
               _vs_install_batch extensions-retry.log $(cat "$(_vs_pending)")
             else ok "nothing pending — no extension install has failed"; fi;;
    *)       error "usage: devbox ext save|restore|list|extras|repair|retry"; exit 1;;
  esac
}

# --- the store ----------------------------------------------------------------

# cmd_store [--repick] : show where the heavy tier lives, and move it when the
# machine's answer has changed.
#
# Re-picking is deliberate and not automatic: the store holds docker's data-root,
# and yanking that out from under a running daemon loses containers. So we stop
# docker first, forget the recorded choice, let pick_store answer again, and let
# the next login rebuild what is missing - VSCode from the cached tarball, the
# extensions from the saved list. Nothing in the store is irreplaceable; that is
# the whole premise of putting it there.
cmd_store() {
  local cur; cur="$(cat "$VS_STORE_RECORD" 2>/dev/null || echo '')"

  case "${1:-}" in
    --set)
      [ -n "${2:-}" ] || { error "usage: devbox store --set <path>"; return 1; }
      store_set "$2" || return 1
      # An explicit choice is an instruction, not a hint: move onto it now.
      cmd_store --repick
      return $?
      ;;
    --clear)
      store_clear
      info "still using $cur until you run: devbox store --repick"
      return 0
      ;;
    --repick) ;;
    ""|--show)
      printf "  %-16s %s\n" "store in use" "${cur:-not chosen yet} ($(avail_gb "${cur:-$VS_TMP}")G free)"
      if [ -n "${VS_STORE_PREF:-}" ]; then
        local why status
        if why="$(store_check "$VS_STORE_PREF")"; then status="$(avail_gb "$VS_STORE_PREF")G free"
        else status="UNAVAILABLE: $why"; fi
        printf "  %-16s %s\n" "your choice" "$VS_STORE_PREF  [$status]"
      else
        printf "  %-16s %s\n" "your choice" "(none — picking automatically)"
      fi
      printf "  %-16s %s\n" "goinfre"      "$VS_GOINFRE ($(avail_gb "$VS_GOINFRE")G free)"
      printf "  %-16s %s\n" "/tmp"         "$VS_TMP ($(avail_gb "$VS_TMP")G free)"
      printf "  %-16s %s\n" "wants"        "${VS_DOCKER_MIN_GB}G free"
      echo
      echo "  devbox store --set /path/to/disk   put it on a disk of your choosing"
      echo "  devbox store --clear               back to automatic (goinfre, else /tmp)"
      echo "  devbox store --repick              move onto the best place available now"
      return 0
      ;;
    *) error "usage: devbox store [--show|--set <path>|--clear|--repick]"; return 1;;
  esac

  local new
  rm -f "$VS_STORE_RECORD"
  new="$(pick_store --interactive)" || { error "no usable store on this machine"; return 1; }
  if [ "$new" = "$cur" ]; then
    warn "still $new ($(avail_gb "$new")G free) — nothing better available"
    printf '%s\n' "$new" > "$VS_STORE_RECORD"
    return 0
  fi

  info "moving the store: $cur -> $new"
  info "stopping your docker first (its data-root lives on the old store) ..."
  systemctl --user stop docker >/dev/null 2>&1 || true
  mkdir -p "$VS_STATE_DIR"; printf '%s\n' "$new" > "$VS_STORE_RECORD"
  rm -f "$VS_STATE_DIR"/{droot,last-ok,vscode-checked}
  ok "store is now $new ($(avail_gb "$new")G free)"
  info "rebuilding VSCode and your extensions there ..."
  "$VS_SETUP_HOME/ensure.sh" --force --interactive
}

# --- repairs -----------------------------------------------------------------

# cmd_fix_perms : take back files a container created.
#
# Two different messes need two different tools:
#   * files owned by an id inside YOUR range (what a rootless container leaves if
#     it ran as a non-root user) -> your own docker can fix them: inside a
#     rootless container, "root" is you, so we chown to 0:0.
#   * files owned by REAL root (left over from before you had your own docker) ->
#     your own docker cannot touch them, because root is outside your id range.
#     Only a daemon running as real root can, so we ask the machine's daemon.
#     No sudo: being in the docker group is enough.
_fp_all_mine() { ! find "$1" \( ! -user "$(id -un)" \) -print -quit 2>/dev/null | grep -q .; }

cmd_fix_perms() {
  local dir mode
  dir="$(cd "${1:-.}" && pwd)"
  mode="$(cat "$VS_STATE_DIR/docker-mode" 2>/dev/null || echo system)"
  _fp_all_mine "$dir" && { ok "$dir is already all yours — nothing to do"; return 0; }

  info "taking back ownership of $dir (docker mode: $mode) ..."
  if [ "$mode" = rootless ]; then
    docker run --rm -v "$dir:/target" alpine:3.20 chown -R 0:0 /target >/dev/null 2>&1 || true
    _fp_all_mine "$dir" && { ok "done — $dir is yours again"; return 0; }
    info "some files belong to real root — asking the machine's own daemon (still no sudo) ..."
    if DOCKER_HOST=unix:///var/run/docker.sock docker run --rm -v "$dir:/target" \
         alpine:3.20 chown -R "$(id -u):$(id -g)" /target >/dev/null 2>&1; then
      _fp_all_mine "$dir" && { ok "done — $dir is yours again"; return 0; }
    fi
  else
    docker run --rm -v "$dir:/target" alpine:3.20 chown -R "$(id -u):$(id -g)" /target >/dev/null 2>&1 || true
    _fp_all_mine "$dir" && { ok "done — $dir is yours again"; return 0; }
  fi

  warn "could not take everything back with docker alone"
  warn "run this once:  sudo chown -R $(id -un):$(id -gn) $dir"
  return 1
}

# --- reclaiming space ---------------------------------------------------------

# _gc_free : free GB on the store, for the before/after line.
_gc_free() { avail_gb "$(store_dir)"; }

# cmd_gc [--hard] : get the store breathing again.
#
# The store fills up quietly and then everything fails at once, in ways that do
# not mention disk: an extension half-installs, a build dies mid-layer. This is
# the "make room" button, and it is careful about what it touches:
#
#   default : things nothing is using - dangling images, the build cache, stopped
#             containers, the UI builder image. Your running containers, your
#             named volumes and your images stay.
#   --hard  : also every image not used by an existing container, and VSCode's
#             caches. Costs you re-pulls and a slower first editor start.
#
# It never touches named volumes: that is where a project's database lives.
cmd_gc() {
  local hard=0; [ "${1:-}" = "--hard" ] && hard=1
  local before after
  before="$(_gc_free)"
  info "store: $(store_dir) — ${before}G free"

  if have docker && docker version >/dev/null 2>&1; then
    info "removing the UI builder image (a whole .NET SDK, only needed while building) ..."
    docker rmi -f "$VS_UI_BUILDER_IMAGE" >/dev/null 2>&1

    info "pruning the docker build cache ..."
    docker builder prune -f >/dev/null 2>&1

    info "removing stopped containers and dangling images ..."
    docker container prune -f >/dev/null 2>&1
    docker image prune -f >/dev/null 2>&1

    if [ "$hard" -eq 1 ]; then
      warn "--hard: removing every image no container is using (you will re-pull them)"
      docker image prune -a -f >/dev/null 2>&1
    fi
  else
    warn "docker is not reachable — skipping the docker half (that is usually most of it)"
  fi

  # VSCode's caches rebuild themselves; the first start after this is slower.
  if [ "$hard" -eq 1 ]; then
    local cache; cache="$(store_path "$VS_CODE_CACHE_NAME" 2>/dev/null)"
    if [ -n "$cache" ] && [ -d "$cache" ]; then
      info "clearing VSCode's caches ($(du -sh "$cache" 2>/dev/null | cut -f1)) ..."
      rm -rf "${cache:?}"/* 2>/dev/null
    fi
  fi

  after="$(_gc_free)"
  ok "${before}G free -> ${after}G free (+$((after - before))G)"
  [ "$hard" -eq 0 ] && info "still tight? 'devbox gc --hard' also drops unused images and VSCode caches"
  return 0
}

# --- the control panel -------------------------------------------------------

# cmd_ui [--build|--docker] [dir] : start the Avalonia app, building/unpacking it
# first if this machine does not have it yet. It opens on <dir> (default: here).
#   --build   rebuild it now, however this machine can
#   --docker  rebuild it in a container (no .NET SDK needed on the machine)
cmd_ui() {
  local build=0 dir
  while [ $# -gt 0 ]; do
    case "$1" in
      --build)  build=1; shift;;
      --docker) build=1; VS_UI_BUILD=docker; shift;;
      -*) error "usage: devbox ui [--build|--docker] [dir]"; exit 1;;
      *) break;;
    esac
  done
  dir="$(cd "${1:-.}" 2>/dev/null && pwd)" || dir="$PWD"
  if [ "$build" -eq 1 ]; then ensure_ui --build || exit 1
  else ensure_ui || exit 1; fi
  exec "$(ui_bin)" "$dir"
}

cmd_goinfre() {
  ensure_goinfre --interactive || { error "could not prepare $VS_GOINFRE"; exit 1; }
  rm -f "$VS_STORE_RECORD"
  info "re-provisioning onto $VS_GOINFRE ..."
  "$VS_SETUP_HOME/ensure.sh" --force --interactive
}

# --- the four-places version check (usable as a CI gate) ---------------------

cmd_check_versions() {
  local root; root="$(cd "${1:-.}" && pwd)"
  local ang="$root/src/Angular"
  [ -d "$ang" ] || ang="$root"
  local nvmrc="" engines="" dockerfile="" devc="" fail=0

  [ -f "$ang/.nvmrc" ] && nvmrc="$(tr -d ' \tv\r\n' < "$ang/.nvmrc")"
  if [ -f "$ang/package.json" ] && have python3; then
    engines="$(python3 -c "
import json,sys
try: print(json.load(open('$ang/package.json')).get('engines',{}).get('node',''))
except Exception: print('')
")"
  fi
  [ -f "$ang/Dockerfile" ] && dockerfile="$(sed -n 's/^FROM node:\([0-9][0-9.]*\).*/\1/p' "$ang/Dockerfile" | head -1)"
  [ -f "$root/.devcontainer/Dockerfile" ] && \
    devc="$(sed -n 's/^ARG NODE_VERSION=\([0-9][0-9.]*\).*/\1/p' "$root/.devcontainer/Dockerfile" | head -1)"

  printf '%-28s %s\n' ".nvmrc"                 "${nvmrc:-<missing>}"
  printf '%-28s %s\n' "package.json engines"   "${engines:-<missing>}"
  printf '%-28s %s\n' "Dockerfile FROM node:"  "${dockerfile:-<missing>}"
  printf '%-28s %s\n' ".devcontainer NODE_VERSION" "${devc:-<missing>}"
  echo

  [ -n "$nvmrc" ] || { error ".nvmrc is missing — nothing to check against"; return 1; }
  local p found=1 missing=0
  for p in "Dockerfile:$dockerfile" ".devcontainer:$devc"; do
    local name="${p%%:*}" val="${p#*:}"
    [ -z "$val" ] && { warn "$name has no Node version to compare"; missing=$((missing+1)); continue; }
    found=$((found+1))
    [ "$val" = "$nvmrc" ] || { error "$name says $val but .nvmrc says $nvmrc"; fail=1; }
  done
  if [ -n "$engines" ]; then
    found=$((found+1))
    case "$engines" in *"$nvmrc"*) : ;;
      *) error "package.json engines ($engines) does not name the pinned $nvmrc"; fail=1;; esac
  else
    warn "package.json has no engines.node"; missing=$((missing+1))
  fi

  if [ "$fail" = 0 ]; then
    if [ "$missing" -eq 0 ]; then ok "all four places agree on Node $nvmrc"
    else ok "the $found place(s) that exist agree on Node $nvmrc — $missing still to write"; fi
  fi
  return "$fail"
}

case "${1:-}" in
  init)           shift; cmd_init "$@";;
  templates)      shift; cmd_templates "$@";;
  ui)             shift; cmd_ui "$@";;
  gc)             shift; cmd_gc "$@";;
  store)          shift; cmd_store "$@";;
  network)        shift; cmd_network "$@";;
  up)             shift; cmd_up "$@";;
  shell)          shift; cmd_shell "$@";;
  down)           shift; cmd_down "$@";;
  open)           shift; cmd_open "$@";;
  container)      shift; cmd_container "$@";;
  where)          shift; cmd_where "$@";;
  ext)            shift; cmd_ext "$@";;
  fix-perms)      shift; cmd_fix_perms "$@";;
  goinfre)        shift; cmd_goinfre "$@";;
  check-versions) shift; cmd_check_versions "$@";;
  doctor)         shift; exec "$VS_SETUP_HOME/bin/setup-doctor" report;;
  *) sed -n '2,18p' "$0" | sed 's/^# \{0,1\}//';;
esac
