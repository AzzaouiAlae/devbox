{
  "name": "angular",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:20",
  "//": "Angular / Node. Extensions install INSIDE the container, not your 5G home.",
  "mounts": [
    "source=${localEnv:HOME},target=/host-home,type=bind"
  ],
  "forwardPorts": [4200],
  "customizations": {
    "vscode": {
      "extensions": [
        "angular.ng-template",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "eamodio.gitlens",
        "ms-azuretools.vscode-docker",
        "redhat.vscode-yaml",
        "editorconfig.editorconfig",
        "tamasfe.even-better-toml"
      ]
    }
  },
  "postCreateCommand": "npm install -g @angular/cli"
}
